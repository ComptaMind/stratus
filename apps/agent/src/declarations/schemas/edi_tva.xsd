<?xml version="1.0" encoding="UTF-8"?>
<!--
  EDI-TVA CA3 XML Schema — Stratus MVP
  Format: DGFiP TDFC/INFENT XML cible TVA-CA3
  Version: 1.0
  CERFA: 3310-CA3-SD

  Structure:
    <Echange>
      <Entete>    — identification de l'émetteur + période
      <Declaration> — lignes CA3 par cadre
      <Signature>   — empreinte SHA-256 du contenu signé
    </Echange>
-->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="urn:dgfip:edi:tva:ca3:v1"
  targetNamespace="urn:dgfip:edi:tva:ca3:v1"
  elementFormDefault="qualified"
  version="1.0">

  <!-- ── Root ─────────────────────────────────────────────────────────────── -->

  <xs:element name="Echange" type="tns:EchangeType"/>

  <xs:complexType name="EchangeType">
    <xs:sequence>
      <xs:element name="Entete"      type="tns:EnteteType"/>
      <xs:element name="Declaration" type="tns:DeclarationType"/>
      <xs:element name="Signature"   type="tns:SignatureType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="version" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ── Entete ────────────────────────────────────────────────────────────── -->

  <xs:complexType name="EnteteType">
    <xs:sequence>
      <!-- SIRET de l'émetteur (14 chiffres) -->
      <xs:element name="SiretEmetteur"    type="tns:SiretType"/>
      <!-- Raison sociale -->
      <xs:element name="IntituleEmetteur" type="xs:string"/>
      <!-- Intent: LIQ (liquidation mensuelle/trimestrielle) -->
      <xs:element name="DacIntent"        type="tns:DacIntentType"/>
      <!-- Régime déclaratif -->
      <xs:element name="Regime"           type="tns:RegimeType"/>
      <!-- Période de déclaration -->
      <xs:element name="Periode"          type="tns:PeriodeType"/>
      <!-- Date d'émission du fichier (ISO-8601) -->
      <xs:element name="DateEmission"     type="xs:date"/>
      <!-- Identifiant unique de session -->
      <xs:element name="Identifiant"      type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="SiretType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DacIntentType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="LIQ"/>
      <xs:enumeration value="RECT"/>
      <xs:enumeration value="TEST"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RegimeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="TVA-CA3"/>
      <xs:enumeration value="TVA-CA3-TRIM"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="PeriodeType">
    <xs:sequence>
      <xs:element name="DateDebut" type="xs:date"/>
      <xs:element name="DateFin"   type="xs:date"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ── Declaration ───────────────────────────────────────────────────────── -->

  <xs:complexType name="DeclarationType">
    <xs:sequence>
      <xs:element name="CadreA" type="tns:CadreType"/>
      <xs:element name="CadreB" type="tns:CadreType"/>
      <xs:element name="CadreD" type="tns:CadreDType"/>
    </xs:sequence>
    <xs:attribute name="cerfa" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="CadreType">
    <xs:sequence>
      <xs:element name="Ligne" type="tns:LigneType" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="ref" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="LigneType">
    <xs:sequence>
      <xs:element name="Montant" type="tns:MontantType"/>
    </xs:sequence>
    <xs:attribute name="ref" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- Monetary amount: up to 15 digits, 2 decimal places, optional sign -->
  <xs:simpleType name="MontantType">
    <xs:restriction base="xs:string">
      <xs:pattern value="-?[0-9]{1,15}(\.[0-9]{2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Cadre D — remboursement de crédit de TVA -->
  <xs:complexType name="CadreDType">
    <xs:sequence>
      <xs:element name="RemboursementDemande" type="xs:boolean"/>
      <xs:element name="RemboursementMontant" type="tns:MontantType"/>
    </xs:sequence>
    <xs:attribute name="ref" type="xs:string" use="required"/>
  </xs:complexType>

  <!-- ── Signature ─────────────────────────────────────────────────────────── -->

  <xs:complexType name="SignatureType">
    <xs:sequence>
      <!-- Algorithm identifier: SHA-256 for MVP -->
      <xs:element name="Algorithm"   type="xs:string"/>
      <!-- Base64-encoded hash of <Entete>+<Declaration> canonical bytes -->
      <xs:element name="DigestValue" type="xs:base64Binary"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
